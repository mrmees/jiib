# Canonical line ending for this repo is LF. It is edited Windows-side, so without this
# Windows editors introduce CRLF and every touched file shows as a phantom full-file diff.
* text=auto eol=lf

# Windows batch scripts check out as CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Freeze the stock Gradle wrapper exactly as committed (AGENTS.md: do NOT alter gradlew*).
gradlew     -text
gradlew.bat -text

# Binary types — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
*.apk binary
*.aab binary
*.bin binary
