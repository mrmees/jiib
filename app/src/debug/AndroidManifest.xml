<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY MANIFEST (D-08 / Pitfall 5). Lives in the `src/debug` source set so the
  manifest merge adds the gallery launcher ONLY in the debug variant — the RELEASE
  variant never sees it. This is the correct seam (NOT a runtime BuildConfig.DEBUG
  guard, which would still register the activity in release).

  It deliberately does NOT touch app/src/main/AndroidManifest.xml (single-owner rule,
  plan 01-01). Two launcher icons in debug (MainActivity + Gallery) is accepted
  (03-RESEARCH Open Question 1). The packaging guard tools/check-release-no-gallery.sh
  proves via `aapt dump badging` that GalleryActivity is ABSENT from the release APK.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
          The in-APK component gallery launcher (D-07). DEBUG-ONLY: present here in the
          debug source set, merged into the debug variant only. GalleryActivity is the
          SOLE assembler of GalleryScreen's deps and opens NO Moonraker connection.
        -->
        <activity
            android:name=".gallery.GalleryActivity"
            android:exported="true"
            android:label="Dinghy Gallery">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
