<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      App theme. Uses a Material3 dark base (a printer-side screen wants a dark,
      high-contrast surface). The AppCompat parent keeps the Views head-to-head
      scene (01-03) able to inflate AppCompat widgets under the same theme.
    -->
    <style name="Theme.JiibDisplay" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
    </style>

    <!--
      Cold-start splash theme (AndroidX core-splashscreen). The launcher activity wears this at
      process start; installSplashScreen() swaps to postSplashScreenTheme once the first frame is
      ready. Black bg + the white "jiib" WORDMARK (name only, no sail), scaled to nearly fill the
      circular icon mask (splash_wordmark) — a wide-short wordmark uses the masked slot far better
      than the square lockup, so it reads at max size. Identical on API 23 (Nexus) and API 31+ (Moto).
    -->
    <style name="Theme.JiibDisplay.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_wordmark</item>
        <item name="postSplashScreenTheme">@style/Theme.JiibDisplay</item>
    </style>
</resources>
