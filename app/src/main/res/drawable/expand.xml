<!--
  Material Symbols Outlined "expand" glyph (two horizontal bars with a vertical double-headed arrow
  between them) — reads as vertical Z movement / nozzle-to-bed gap. Source SVG uses the Material
  Symbols 960 viewBox with a -960..0 Y range, so the path is wrapped in a group translated +960 into
  Android's 0..960 viewport. Filled white, recolored at runtime via Compose Icon(tint = …) (THEME-01).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960">
    <group android:translateY="960">
        <path
            android:pathData="M160,-80v-80h640v80H160Zm320,-120L320,-360l56,-56 64,62v-252l-64,62 -56,-56 160,-160 160,160 -56,56 -64,-62v252l64,-62 56,56 -160,160ZM160,-800v-80h640v80H160Z"
            android:fillColor="#FFFFFFFF" />
    </group>
</vector>
