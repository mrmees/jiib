<!--
  Caution-status glyph (upward triangle silhouette + inner "!" mark). D-01/D-02: the OUTER 3-gon
  contour is the safety mechanism (distinct from the octagon in grayscale/CVD), the inner "!" is
  secondary redundancy. Geometry only — strokes drawn white and recolored at the call site via
  Compose Icon(tint = t.heat /* caution */) / DrawableCompat.setTint in the console row
  (THEME-01); NEVER a status hex baked in. Same convention as nozzle.xml / heat_bed.xml.

  Outer path is an upward equilateral-ish triangle (apex top-centre, base across the bottom),
  rounded joins for the classic warning-sign read. Inner "!" = a vertical bar above a dot.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">
    <path
        android:pathData="M48,14L86,80L10,80Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M48,40L48,60"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M48,70L48,70"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
