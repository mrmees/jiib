<!--
  Babystep COMPRESS glyph (nozzle moves CLOSER to the bed). Silhouette: a downward chevron pair
  pressing toward a baseline (the bed) at the bottom — the "squeeze gap smaller / nozzle down" cue.
  DISTINCT from ic_babystep_expand (which points UP away from the baseline) — icon-never-twice rule.

  Geometry only — strokes drawn white and recolored at the call site via Compose Icon(tint =
  t.accentLine) (THEME-01); NEVER a status/accent hex baked in. Same white-stroke-tinted-at-call-site
  convention as ic_status_octagon.xml / nozzle.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">
    <!-- Baseline (the bed) at the bottom. -->
    <path
        android:pathData="M20,78L76,78"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
    <!-- Two stacked downward chevrons pressing toward the baseline. -->
    <path
        android:pathData="M30,24L48,42L66,24"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M30,46L48,64L66,46"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
