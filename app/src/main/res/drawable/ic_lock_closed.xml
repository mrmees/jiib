<!--
  Closed-padlock glyph for the force-move SAFE state (D-12 redundant non-color signal). The CLOSED
  silhouette = the shackle's two legs BOTH meet the lock body (a sealed loop on top of the body), so
  the shape reads "locked" at a glance, distinct from ic_lock_open (one leg lifted free of the body).
  Geometry only — strokes drawn white and recolored at the call site via Compose
  ColorFilter.tint(t.go) (THEME-01); NEVER a status hex baked in. Same white-stroke-tinted-at-call-site
  convention as nozzle.xml / ic_status_octagon.xml.

  Body = a rounded rectangle (lower half). Shackle = a closed arch whose BOTH legs land on the body
  top edge (engaged). Keyhole dot for the classic padlock read.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">
    <!-- Lock body -->
    <path
        android:pathData="M26,46h44c2.2,0,4,1.8,4,4v26c0,2.2-1.8,4-4,4H26c-2.2,0-4-1.8-4-4V50c0-2.2,1.8-4,4-4Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- Shackle: closed arch, BOTH legs reach the body top (engaged) -->
    <path
        android:pathData="M34,46V36c0,-7.7,6.3,-14,14,-14s14,6.3,14,14v10"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- Keyhole -->
    <path
        android:pathData="M48,60L48,60"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
