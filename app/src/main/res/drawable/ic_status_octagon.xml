<!--
  Stop-status glyph (regular octagon silhouette + inner ✕ mark). D-01/D-02: the OUTER 8-gon
  contour is the safety mechanism (survives grayscale/CVD), the inner ✕ is secondary redundancy.
  Geometry only — strokes drawn white and recolored at the call site via Compose
  Icon(tint = t.stop) / DrawableCompat.setTint in the console row (THEME-01); NEVER a status hex
  baked in. Same white-stroke-tinted-at-call-site convention as nozzle.xml / heat_bed.xml.

  Outer path is a regular octagon inscribed in the 96 viewport (8 vertices at 45° spacing on a
  circle of radius 42 about centre 48,48, starting at 22.5° so the flat top edge reads "STOP"
  sign-like). Inner ✕ is two crossing diagonals.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">
    <path
        android:pathData="M86.8,48L78.8,67.2L59.6,75.1L40.4,75.1L21.2,67.2L13.2,48L21.2,28.8L40.4,20.9L59.6,20.9L78.8,28.8Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M38,38L58,58M58,38L38,58"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
