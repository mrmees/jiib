<?xml version="1.0" encoding="utf-8"?>
<!--
  SHARED MANIFEST — SINGLE OWNER (plan 01-01).
  The Wave-2 plans (01-02 cleartext smoke, 01-03 benchmark scenes) MUST NOT edit
  this file or res/xml/network_security_config.xml. This plan owns the cleartext
  posture and activity registration so the wave never collides on shared files.

  Cleartext posture (CONN-05 / D-10 / RESEARCH #6 — the two switches govern
  DIFFERENT API ranges and never conflict on one device):
    * android:usesCleartextTraffic="true"   -> governs API 23 (NSC is ignored < API 24)
    * android:networkSecurityConfig=@xml/... -> governs API 24+ (wins over the flag there)
  This phase proves the Marshmallow (API 23) path only; the API-24+ cleartext
  path is re-validated in a later phase (D-11).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The only permission Phase 1 needed: cleartext ws:// + http:// to LAN Moonraker. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Phase 4 (04-03) — foreground-service stack (ADD ONLY, Phase-1 posture above untouched):
        * FOREGROUND_SERVICE + *_SPECIAL_USE: the started FGS that owns the Moonraker spine and keeps
          the LAN websocket alive across Activity recreation + screen-off (D-01, SHELL-03). specialUse
          avoids Android-15's dataSync 6h cap; Play justification moot (sideload). Enforcement is a
          no-op on the API-30 test device but MUST be declared for targetSdk 35 / newer hardware.
        * POST_NOTIFICATIONS: the persistent low-importance status notification (API 33+ runtime grant).
        * CHANGE_WIFI_MULTICAST_STATE: the 04-01 best-effort mDNS _moonraker._tcp scan MulticastLock.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
      Phase 11 (SPOOL-05/06) — QR-scan camera (ADD ONLY; Phase-1 cleartext posture untouched):
        * CAMERA: runtime permission for the scan surface; requested ONLY at scan entry (11-07)
          via the Activity Result API, never at launch.
        * uses-feature camera (+ autofocus) required="false" is LOAD-BEARING (D-15): a camera-less
          device STILL installs and degrades to the manual spool picker. Without required="false"
          the Play/installer feature filter would exclude such devices; we sideload, but the
          declaration keeps the install floor honest and documents the optional-hardware contract.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".DinghyApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.DinghyDisplay">

        <!-- Launcher entry point. Compose host; placeholder body this phase. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Benchmark harness entry point — exported so :macrobenchmark / UiAutomator
          can launch it with a scene-select intent extra. The scenes + synthetic
          feed are implemented in plan 01-03 (compose/views) and plan 03-07 (render
          (the ring+graph perf scene for the D-10 gfxinfo capture). The registration
          itself is unchanged; scene selection is an intent extra (es scene render),
          not a new activity.
        -->
        <activity
            android:name=".bench.BenchActivity"
            android:exported="true" />

        <!--
          The started foreground service that owns the Moonraker spine (04-03). NOT exported and NOT
          bound — state is process-held in AppContainer; the Activity collects StateFlow<SpineHandle?>.
          specialUse subtype is a free-text justification (no Play review; sideloaded APK).
        -->
        <service
            android:name=".service.MoonrakerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains a persistent LAN websocket session to a Klipper/Moonraker 3D printer for live status and control" />
        </service>

    </application>

</manifest>
